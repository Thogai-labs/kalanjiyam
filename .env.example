# Copy to .env and fill in real values. Never commit .env.

# Flask / app
FLASK_ENV=development
SECRET_KEY=change-me
SQLALCHEMY_DATABASE_URI=sqlite:///database.db
FLASK_UPLOAD_FOLDER=/absolute/path/to/data/file-uploads

# URL prefix — set to /kalanjiyam when hosting at siddhasagaram.in/kalanjiyam
# Leave empty for root hosting (http://localhost:5000/)
APPLICATION_URL_PREFIX=

# Storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local

# Automatic cleanup of uploaded source PDF and DOC/DOCX files older than 7 days (true / false)
AUTO_UPLOADED_FILES_CLEANUP=false

# Global Access Controls
ENABLE_GUEST_ACCESS=true
ENABLE_REGISTERED_ACCESS=true

# S3-compatible storage (required when STORAGE_BACKEND=s3)
# Works with AWS S3, versitygw, MinIO, or any S3-compatible service.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads
S3_ENDPOINT_URL=http://localhost:7070
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=

# Remote OCR service (required when OCR_BACKEND=remote)
# v2 API: text, bounding_boxes, blocks, layout_html — see docs/ocr-api.rst
# LlamaParse / hybrid pipeline is configured on the OCR service (LLAMA_CLOUD_API_KEY).
OCR_BACKEND=remote
OCR_SERVICE_URL=http://localhost:5001
OCR_SERVICE_API_KEY=
# Fallback OCR service (used automatically if primary OCR_SERVICE_URL is unreachable)
OCR_SERVICE_URL_2=http://10.129.6.170:8887
OCR_SERVICE_API_KEY_2=
OCR_SERVICE_TIMEOUT=300
DEFAULT_OCR_ENGINE=tesseract
DEFAULT_TRANSLATION_ENGINE=indictrans2

# Remote Translation service
TRANSLATION_SERVICE_URL=http://localhost:8888
TRANSLATION_SERVICE_API_KEY=
TRANSLATION_SERVICE_TIMEOUT=300

# BharatGen Translation service
BHARATGEN_TRANSLATION_API_URL=https://api.bharatgen.dev/v1/chat/completions
BHARATGEN_TRANSLATION_API_KEY=
BHARATGEN_TRANSLATION_TIMEOUT=300

# LLM Gemma Translation service (defaults to OCR_SERVICE_URL/v1/ocr)
LLM_GEMMA_TRANSLATION_API_URL=
LLM_GEMMA_TRANSLATION_API_KEY=
LLM_GEMMA_TRANSLATION_TIMEOUT=300

# Save original DOCX contents to database during direct DOCX translation (true / false)
SAVE_DOCX_DIRECT_TR_DATA=false

# Full-text search (OpenSearch). See docs/search.rst.
# When SEARCH_ENABLED=false the app never contacts the cluster.
SEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
SEARCH_INDEX_PREFIX=kalanjiyam
SEARCH_BULK_CHUNK_SIZE=500
SEARCH_RESULTS_PER_PAGE=20
SEARCH_REQUEST_TIMEOUT=30

# Background tasks
REDIS_URL=redis://localhost:6379/0
KALANJIYAM_BOT_PASSWORD=change-me

# Production only
SENTRY_DSN=

# Multi-tenant / organizations (see docs/multi-tenant.rst)
MULTI_TENANT_MODE=false
ENFORCE_ORG_ACCESS=true
DEFAULT_PROJECT_REQUIRES_ORG=true
GUEST_DAILY_PROJECT_LIMIT=5
GUEST_DAILY_OCR_LIMIT=10
# Legacy group gates (optional; can combine with org mode)
ENFORCE_GROUP_ACCESS_FOR_PROJECTS=false
ENFORCE_GROUP_ACCESS_FOR_TEXTS=false
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Docker ports per environment
KALANJIYAM_HOST_IP=127.0.0.1
KALANJIYAM_DEV_HOST_PORT=5002
KALANJIYAM_STAGING_HOST_PORT=5001
KALANJIYAM_HOST_PORT=5000
POSTGRES_PASSWORD=change-me

# Host directory where all application uploads/data will be stored.
# If empty or not defined, defaults to ~/kalanjiyam-data.
# On servers with restricted home directory quotas, point this to a spacious mount point
# (e.g., KALANJIYAM_DATA_DIR=/home1/student/username/kalanjiyam-data).
KALANJIYAM_DATA_DIR=
